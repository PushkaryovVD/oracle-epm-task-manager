{
  "_note": "Column catalogue. Primary aliases are the headers of a real Oracle Task Manager export (Unformatted / For Future Import, CSV). Headers match case-insensitively ignoring spaces and punctuation. 'multi' fields repeat with a number suffix (Approver1, Approver2...) and are paired by that number.",
  "fields": [
    {"key": "task_id", "label": "TaskID", "required": true, "aliases": ["TaskID", "Task ID", "ID", "Task Code"]},
    {"key": "task_name", "label": "TaskName", "required": true, "aliases": ["TaskName", "Task Name", "Name", "Task"]},
    {"key": "task_type", "label": "TaskType", "required": true, "aliases": ["TaskType", "Task Type", "Type"]},
    {"key": "org_unit", "label": "OrganizationalUnit", "aliases": ["OrganizationalUnit", "Org Unit", "Organization Unit"]},
    {"key": "description", "label": "Description", "aliases": ["Description", "Task Description"]},
    {"key": "priority", "label": "Priority", "allowed": ["Low", "Medium", "High"], "aliases": ["Priority"]},
    {"key": "start_day_offset", "label": "StartDate", "integer": true, "aliases": ["StartDate", "Start Day", "Start Day Offset", "Start Offset"]},
    {"key": "start_time", "label": "StartTime", "time": true, "aliases": ["StartTime"]},
    {"key": "duration", "label": "Duration", "integer": true, "aliases": ["Duration"]},
    {"key": "minimum_duration", "label": "MinimumDuration", "integer": true, "aliases": ["MinimumDuration"]},
    {"key": "owner", "label": "Owner", "aliases": ["Owner", "Task Owner"]},
    {"key": "assignee", "label": "Assignee", "aliases": ["Assignee", "Assigned To"]},
    {"key": "backup_assignee", "label": "BackupAssignee", "aliases": ["BackupAssignee"]},
    {"key": "end_day_offset", "label": "AssigneeEndDate", "integer": true, "aliases": ["AssigneeEndDate", "End Day", "End Day Offset", "End Offset", "EndDate"]},
    {"key": "end_time", "label": "AssigneeEndTime", "time": true, "aliases": ["AssigneeEndTime", "EndTime"]},
    {"key": "require_completion_by", "label": "RequireCompletionBy", "aliases": ["RequireCompletionBy"]},
    {"key": "active", "label": "Active", "allowed": ["Yes", "No"], "aliases": ["Active"]},
    {"key": "template_ref", "label": "Template", "aliases": ["Template"]},
    {"key": "start_early", "label": "StartEarly", "allowed": ["Yes", "No"], "aliases": ["StartEarly"]},
    {"key": "run_as", "label": "RunAs", "aliases": ["RunAs"]},
    {"key": "instructions", "label": "Instruction", "aliases": ["Instruction", "Instructions", "Instruction Text"]},
    {"key": "parent_task_id", "label": "Parent", "aliases": ["Parent", "Parent Task", "Parent Task ID", "ParentID"]},
    {"key": "template_name", "label": "Template Name", "aliases": ["Template Name"]},

    {"key": "predecessor", "label": "Predecessor", "multi": true, "aliases": ["Predecessor", "Predecessors", "Predecessor Task", "Predecessor Task ID"]},
    {"key": "pred_type", "label": "PredType", "multi": true, "allowed": ["Finish to Start", "Finish to Finish", "Finish Error to Start", "Finish Error to Finish"], "aliases": ["PredType"]},
    {"key": "pred_template", "label": "PredTemplate", "multi": true, "aliases": ["PredTemplate"]},

    {"key": "approver", "label": "Approver", "multi": true, "aliases": ["Approver", "Approver Level"]},
    {"key": "approver_backup", "label": "ApproverBackup", "multi": true, "aliases": ["ApproverBackup"]},
    {"key": "approver_end_day_offset", "label": "ApproverEndDate", "multi": true, "integer": true, "aliases": ["ApproverEndDate"]},
    {"key": "approver_end_time", "label": "ApproverEndTime", "multi": true, "time": true, "aliases": ["ApproverEndTime"]},
    {"key": "approver_require_completion_by", "label": "ApproverRequireCompletionBy", "multi": true, "aliases": ["ApproverRequireCompletionBy"]},

    {"key": "q_text", "label": "QText", "multi": true, "aliases": ["QText"]},
    {"key": "q_type", "label": "QType", "multi": true, "aliases": ["QType"]},
    {"key": "q_role", "label": "QRole", "multi": true, "aliases": ["QRole"]},
    {"key": "q_required", "label": "QReq", "multi": true, "allowed": ["Yes", "No"], "aliases": ["QReq"]},
    {"key": "q_list", "label": "QList", "multi": true, "aliases": ["QList"]},
    {"key": "q_currency_symbol", "label": "QCurrSymb", "multi": true, "aliases": ["QCurrSymb"]},
    {"key": "q_decimal_places", "label": "QDecPlaces", "multi": true, "aliases": ["QDecPlaces"]},
    {"key": "q_percent", "label": "QPercent", "multi": true, "aliases": ["QPercent"]},
    {"key": "q_negative_format", "label": "QNegNumFmt", "multi": true, "aliases": ["QNegNumFmt"]},
    {"key": "q_scale", "label": "QScale", "multi": true, "aliases": ["QScale"]},
    {"key": "q_thousands_separator", "label": "QThouSep", "multi": true, "aliases": ["QThouSep"]},
    {"key": "q_text_lines", "label": "QTextLines", "multi": true, "aliases": ["QTextLines"]},
    {"key": "q_include_attachments", "label": "QInclAttach", "multi": true, "aliases": ["QInclAttach"]},
    {"key": "q_attachment_access", "label": "QAttachAccess", "multi": true, "aliases": ["QAttachAccess"]},

    {"key": "parameter", "label": "Parameter", "multi": true, "aliases": ["Parameter"]},
    {"key": "parameter_value", "label": "ParamVal", "multi": true, "aliases": ["ParamVal"]}
  ],
  "predecessor_separators": ",;\n",
  "header_scan_rows": 20,
  "max_issue_rows_listed": 10
}
